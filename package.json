    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/semver": "^7.8.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.6",
