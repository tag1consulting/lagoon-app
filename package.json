    "expo": "~57.0.13",
    "expo-auth-session": "~57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.12",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.2.1",
    "react": "19.2.3",
